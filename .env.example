# Predloga. V gitu je samo ta datoteka, s praznimi vrednostmi (člen IV).
# Izpolnjena kopija živi IZVEN repozitorija:
#   produkcija (VPS):  ../envs/.env.cleverdashNew  (poda jo scripts/vps-compose.sh)
#   lokalni razvoj:    .env v korenu (negiten, bere ga `npm run dev:api`)
# Popoln opis vsake spremenljivke: docs/env-reference.md

# ─── Osnovno ───
NODE_ENV=production
# Velja za lokalni razvoj. V produkciji vrata pripne infra/docker-compose.yml
# (`PORT: "3010"`), ker sta 3000 in 3002 na VPS-u že v rabi, nanje pa je vezan tudi
# `reverse_proxy` v infra/cleverdash.caddyfile — vrednost tukaj je tam brez učinka.
PORT=3000
TZ=Europe/Ljubljana
PUBLIC_BASE_URL=https://app.si
APP_NAME=CleverDash
LOG_LEVEL=info
# Ta sklad nima svojega Caddyja: TLS, strežbo SPA-ja in usmerjanje /api/* opravi SKUPNI
# Caddy na VPS-u (blok zanj je v infra/cleverdash.caddyfile). Zato tu ni spremenljivk za
# vrata ali naslov strani — PUBLIC_BASE_URL zgoraj pa mora kljub temu biti pravi javni
# naslov, ker iz njega nastaneta preusmeritev na prijavo in obseg piškotka.

# ─── Baza ───
# Produkcija uporablja MongoDB, ki na VPS-u že teče (vsebnik `mongo` iz sklada planego) —
# ta sklad svojega nima. `mongo` se razreši samo, ker je api v infra/docker-compose.yml
# priključen na omrežje planego-network.
#
# Baza je kljub skupnemu strežniku SVOJA: CleverDash ima zbirke `users`, `settings`,
# `notes` ..., ki se s planegovimi imensko prekrivajo, zato bi `/planego` pomešal podatke
# obeh aplikacij. Uporabnik `admin` z `authSource=admin` do `/cleverdash` dostopa brez
# dodatnega ustvarjanja uporabnika.
MONGO_URI=mongodb://admin:CHANGEME@mongo:27017/cleverdash?authSource=admin
# Ime obstoječega Dockerjevega omrežja z Mongom. Privzetek `planego-network` velja, kadar
# je omrežje ustvarjeno neposredno; če ga je naredil compose sklada planego, ima predpono
# projekta (`planego_planego-network`). Preveri z `docker network ls` — ob napačnem imenu
# compose glasno pade, sklad se ne zažene s tiho nedosegljivo bazo.
PLANEGO_NETWORK=planego-network

# ─── Avtentikacija (004: Keycloak namesto e-pošte/gesla — specs/004-keycloak-sso-multiuser) ───
# Dostopni žeton, ki ga CleverDash vrne SPA, je Keycloakov lasten (relay) — ni lokalno
# podpisan. SESSION_COOKIE_SECRET podpiše sejni piškotek, ki referencira KeycloakSession
# (nadomešča prejšnji JWT_REFRESH_SECRET).
SESSION_COOKIE_SECRET=
# Organizacijski Keycloak; CleverDash se nanj samo priklopi, svojega vsebnika ne postavlja.
# Realm, odjemalca in vlogi na produkcijskem Keycloaku (kc.planego.eu) postavi
# `scripts/keycloak-prod-setup.sh` in na koncu izpiše natanko te štiri vrednosti — sem jih
# samo prilepi. Za lokalni razvoj glej specs/004-keycloak-sso-multiuser/quickstart.md §1.
# KEYCLOAK_ISSUER_URL vključuje realm: https://kc.planego.eu/realms/cleverdash
KEYCLOAK_ISSUER_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_ROLE=cleverdash-admin
KEYCLOAK_USER_ROLE=cleverdash-user
KEYCLOAK_INTROSPECTION_CACHE_SECONDS=5

# ─── Brskalnik (za 002, tukaj že v shemi zaradi skupne konfiguracije) ───
PUPPETEER_SKIP_DOWNLOAD=true
# Pot velja za GOSTITELJA, na katerem teče `npm run dev:api`. Vsebnik svojo pot dobi iz
# infra/docker-compose.yml (tam nastavljena vrednost povozi to datoteko), zato jo tu smeš
# nastaviti na svoj sistem:
#   Linux (tudi WSL):  /usr/bin/chromium
#   Windows:           C:/Program Files/Google/Chrome/Application/chrome.exe
#   macOS:             /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Za razvoj brez pravega brskalnika je namesto tega dovolj CLOCK_PORTAL=fake.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_PROTOCOL_TIMEOUT_MS=60000
# Chromiumov lastni peskovnik (ločen od Dockerjeve izolacije) zahteva zmožnost
# uporabniških imenskih prostorov, ki jo privzeti profil seccomp/AppArmor v vsebniku
# blokira ("No usable sandbox!", preverjeno T121, docs/acceptance-002.md). --no-sandbox je
# tu uradno priporočen izhod za headless Chromium v vsebnikih (glej pptr.dev/troubleshooting)
# — Dockerjeva lastna izolacija (vsebnik + neprivilegiran uporabnik, glej api.Dockerfile) je
# dejanska varnostna meja, ne Chromiumov notranji peskovnik.
BROWSER_NO_SANDBOX=true

# ─── Scheduler (za 002) ───
# PRVO od dveh stikal. To je stikalo NAMESTITVE: ali tik sploh teče (main.ts). Drugo je
# osebno stikalo vsakega uporabnika (zaslon Urnik → "Izvajaj moje urnike samodejno",
# PUT /api/v1/time-tracking/automation), ki je PRIVZETO IZKLOPLJENO. Oba morata biti
# vklopljena, da se karkoli klikne — vklop tukaj sam po sebi ne sproži ničesar pri nikomer.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULE_TIMEZONE=Europe/Ljubljana
DRY_RUN=false
CLOCK_PORTAL=puppeteer

# ─── Obvestila ───
# GOOGLE_APPLICATION_CREDENTIALS je pot V VSEBNIKU (stalna). FCM_KEY_FILE je pot na
# GOSTITELJU (per-stroj) — glej infra/docker-compose.yml, ki jo montira kot bind mount.
# Gre za Google service account JSON za FCM; rabijo ga SAMO potisna obvestila na Android
# (opomniki in opozorila beleženja časa). Prazna vrednost je dovoljena: sklad se normalno
# zažene, potisna obvestila pa tiho ne delujejo.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/fcm_key
FCM_KEY_FILE=
NOTIFY_ON_SUCCESS=false

# ─── Zdravje ───
HEALTHCHECK_PING_URL=
HEALTHCHECK_PING_TIMEOUT_MS=5000

# ─── Datoteke ───
SCREENSHOT_DIR=/app/data/screenshots
SCREENSHOT_RETENTION_DAYS=30

# ─── ARSO ───
ARSO_RADAR_URL=https://meteo.arso.gov.si/uploads/probase/www/observ/radar/si0-rm-anim.gif
ARSO_WEATHER_URL=https://vreme.arso.gov.si/api/1.0/location/
ARSO_WEBCAM_BASE_URL=https://meteo.arso.gov.si/uploads/probase/www/observ/webcam/
ARSO_DEFAULT_LOCATION=Ljubljana
RADAR_CACHE_SECONDS=300
WEATHER_CACHE_SECONDS=600
# ARSO_STATION_BASE_URL je MAPA, ne datoteka: ime datoteke se sestavi iz oznake postaje
# (zavihek "Meritve ARSO", 011). ARSO_DEFAULT_STATION je privzetek za uporabnika, ki si
# postaje še ni izbral — oznaka je `domain_meteosiId` brez zaključnega podčrtaja (VRHNIKA,
# NOVA-GOR_BILJE), NE ime kraja.
ARSO_STATION_BASE_URL=https://meteo.arso.gov.si/uploads/probase/www/observ/surface/text/sl/
ARSO_DEFAULT_STATION=LJUBL-ANA_BEZIGRAD
METEO_CACHE_SECONDS=600
METEO_STATIONS_CACHE_SECONDS=21600

# Neverin (neverin.hr) — drugi ponudnik meritev poleg ARSO: omrežje ~1335 postaj v Sloveniji,
# na Hrvaškem, v BiH, Srbiji in Črni gori (postaje, ki jih ARSO nima).
#
# NEVERIN_BASE_URL je API, ki ga uporablja njihova stran; NEVERIN_WEB_URL je izvor, ki se
# pošlje v glavah Origin in Referer — brez njega vir odgovori 403 (ORIGIN_BLOCKED). Njihovi
# pogoji uporabe avtomatiziran dostop omejujejo, zato je to zavestna odločitev lastnika
# namestitve: TTL je zato dolg (en prenos na postajo na 10 minut, ne glede na število
# uporabnikov). Prazen NEVERIN_BASE_URL ni predviden — ponudnika izklopiš tako, da nobene
# njegove postaje ne izbereš.
NEVERIN_BASE_URL=https://core.neverin.hr
NEVERIN_WEB_URL=https://www.neverin.hr
NEVERIN_CACHE_SECONDS=600
NEVERIN_STATIONS_CACHE_SECONDS=21600

# ─── Pot v službo in domov (ploščica "Pot", neobvezno) ───
# DVA LOČENA KLJUČA in to ni podvajanje:
#  - GOOGLE_MAPS_SERVER_KEY kliče Routes API in ostane samo na strežniku. V Google Cloud
#    konzoli ga omeji po naslovu IP strežnika in dovoli samo "Routes API".
#  - GOOGLE_MAPS_EMBED_KEY konča v naslovu <iframe> in ga zato VIDI vsak obiskovalec. Mora
#    biti drug ključ, omejen po napotitelju (HTTP referrer) na PUBLIC_BASE_URL in samo na
#    "Maps Embed API". Brez njega se zemljevid izriše prek klasične oblike output=embed,
#    ki ključa ne potrebuje.
# Brez GOOGLE_MAPS_SERVER_KEY ploščica deluje naprej: pokaže zemljevida, čas poti pa pove,
# da ključa ni. Kraja (doma, služba) NISO tu — sta osebna nastavitev v profilu.
# COMMUTE_CACHE_SECONDS: vsaka osvežitev je ENA plačljiva zahteva na smer; višja vrednost
# pomeni manj stroškov in manj sveže podatke o prometu.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_EMBED_KEY=
GOOGLE_ROUTES_URL=https://routes.googleapis.com/directions/v2:computeRoutes
COMMUTE_CACHE_SECONDS=300
COMMUTE_ROUTES_TIMEOUT_MS=8000

# ─── E-pošta (neobvezno — glej research.md §1.2) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# ─── Kamere (003, specs/003-cameras/research.md §13/§14) ───
CAMERA_ALLOWED_EMBED_HOSTS=youtube.com,ipcamlive.com,istrastream.com,arso.gov.si
CAMERA_UNREACHABLE_THRESHOLD=3
CAMERA_DEGRADED_REFRESH_MULTIPLIER=4
CAMERA_DEFAULT_REFRESH_SECONDS=30
# 32 bajtov v base64 (44 znakov) — generiraj z: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# ─── Beležke (007, specs/007-notes) ───
# Zgornja meja za en zvočni posnetek beležke.
NOTES_AUDIO_MAX_MB=10
# NEOBVEZNO: storitev za prepis govora (OpenAI-jev protokol /v1/audio/transcriptions ali
# združljiva — whisper.cpp server, faster-whisper-server, Groq). Prazno pomeni, da prepisa na
# strežniku NI: narekovanje teče v brskalniku in posnetek nikoli ne zapusti strežnika.
#
# POZOR: nastavljen ključ SAM PO SEBI ne pomeni, da se posnetki pošiljajo ven. Vsak uporabnik
# mora to še izrecno vklopiti v Nastavitve → Moduli → Beležke (notes.serverTranscription,
# privzeto izklopljeno). Ključ je dovoljenje namestitve, stikalo pa privolitev osebe.
NOTES_TRANSCRIPTION_URL=
NOTES_TRANSCRIPTION_API_KEY=
NOTES_TRANSCRIPTION_MODEL=whisper-1
NOTES_TRANSCRIPTION_LANGUAGE=sl
NOTES_TRANSCRIPTION_TIMEOUT_MS=120000

# ─── Deljenje datotek (009, specs/009-file-sharing) ───
# VSE spodnje je NEOBVEZNO — vsaka vrednost ima privzetek v kodi
# (apps/api/src/platform/config/env.ts), zato `docker compose up` iz čiste kopije deluje brez
# dopolnjevanja tega bloka (kakovostna vrata, točka 4).
#
# POZOR na namestitev: vsebina datotek NI v bazi, ampak na trajnem nosilcu `shared-files`
# (infra/docker-compose.yml). Brez montiranega nosilca naložene datoteke izginejo ob prvi
# posodobitvi slike.
#
# Koren hrambe v vsebniku — mora se ujemati z nosilcem iz docker-compose.yml.
FILE_SHARE_DIR=/app/data/files
# Največja ena datoteka in skupna kvota na uporabnika.
FILE_SHARE_MAX_MB=500
FILE_SHARE_QUOTA_MB=5000
# Privzeti rok veljavnosti povezave in koliko časa po poteku vsebina še obstaja na disku.
FILE_SHARE_DEFAULT_EXPIRY_DAYS=7
FILE_SHARE_RETENTION_DAYS=7
# Koliko časa velja odklenitev z geslom, preden ga je treba vpisati znova.
FILE_SHARE_GRANT_MINUTES=10
# Dušenje ugibanja gesla na JAVNI poti: koliko zgrešitev v kakšnem oknu in kako dolgo traja
# zavrnitev. Med zavrnitvijo je zavrnjeno tudi pravilno geslo.
FILE_SHARE_ATTEMPT_LIMIT=10
FILE_SHARE_ATTEMPT_WINDOW_MINUTES=15
FILE_SHARE_LOCK_MINUTES=60
# Pometač: kako pogosto teče in kdaj velja nalaganje za obtičalo.
FILE_SHARE_CLEANUP_INTERVAL_MINUTES=60
FILE_SHARE_UPLOAD_TIMEOUT_MINUTES=360
# 009b — sprejemni predali (obrnjena smer: nekdo brez računa nam odda datoteko).
#
# Ti dve sta STROPA, ne vrednosti predala: koliko datotek in koliko skupaj sme lastnik dovoliti
# ENEMU predalu, izbere sam ob njegovem nastanku. Brez stropa bi bila edina meja kvota lastnika,
# torej bi kdor koli, ki ima kodo, lahko porabil ves njegov prostor.
FILE_SHARE_INBOX_MAX_FILES=10
FILE_SHARE_INBOX_MAX_MB=1000
# Koliko časa velja odklenitev s kodo za oddajo. Bistveno dlje od FILE_SHARE_GRANT_MINUTES:
# prevzem se sproži z navigacijo takoj, oddaja pa mora zdržati, dokler nekdo izbira datoteke in
# jih pošilja prek počasne povezave.
FILE_SHARE_INBOX_TICKET_MINUTES=60

# ─── Shranjeni linki (008, specs/008-saved-links) ───
# VSE TRI so NEOBVEZNE — vsaka ima privzetek v kodi
# (apps/api/src/platform/config/env.ts), zato `docker compose up` iz čiste kopije deluje brez
# dopolnjevanja tega bloka (kakovostna vrata, točka 4).
#
# Prvi dve sta PRORAČUN za branje imena tuje strani, ne nastavitev zmogljivosti: strežnik
# obišče shranjeni naslov samo zato, da prebere `<title>` in razreši favicon, in to stori
# enkrat ob shranjevanju ter nato le na izrecno zahtevo. Meji varujeta tudi tujo stran, ne le
# nas (člen VIII). Prekoračitev NI napaka uporabniku — zapis obstane z `metadataStatus: failed`.
SAVED_LINKS_METADATA_TIMEOUT_MS=2500
SAVED_LINKS_METADATA_MAX_BYTES=131072
# Predpomnilnik favicona. Ključ je GOSTITELJ in ne zapis, zato je dvajset shranjenih strani z
# `github.com` en prenos na teden, ne dvajset (research.md §4). 604800 s = 7 dni.
SAVED_LINKS_FAVICON_TTL_SECONDS=604800

# ─── Recepti (013, specs/013-recipes) ───
# VSE so NEOBVEZNE — vsaka ima privzetek v kodi (apps/api/src/platform/config/env.ts), zato
# `docker compose up` iz čiste kopije deluje brez dopolnjevanja tega bloka (kakovostna vrata,
# točka 4).
#
# Tu NI spremenljivke za imenik: slike receptov so v BAZI kot `Buffer`, ne na nosilcu
# (research.md §4) — nasprotno od FILE_SHARE_DIR zgoraj. Odločilen ni prostor, ampak to, da se
# slika in recept ne smeta raziti: na disku bi bila slika zunaj varnostne kopije baze in bi
# lahko preživela svoj recept.
#
# 8 MB je fotografija s telefona po običajnem stiskanju; nad tem gre skoraj gotovo za
# nestisnjen zajem, ki ga je ceneje zavrniti kot shraniti stokrat.
RECIPES_IMAGE_MAX_MB=8
# Pomanjšava za seznam, ki jo izračuna ODJEMALEC v `<canvas>`. SVOJA, nižja meja in ne ista kot
# zgoraj: pomanjšava je za strežnik nepreverjen vnos, zato bi meja izvirnika pomenila, da je
# `thumb` odprta vrata za vse, česar `data` ne dovoli. 512 kB je z veliko rezervo dovolj za
# stranico 600 px.
RECIPES_THUMB_MAX_KB=512
# Zgornja meja slik na recept. Recept s petnajstimi fotografijami je album, ne recept.
RECIPES_MAX_IMAGES=12
# Proračun za uvoz recepta s tuje strani (schema.org/Recipe). Daljši od branja `<title>` v
# modulu 008 (2500 ms), ker uvoz teče ob IZRECNI potezi uporabnika, ki nanj čaka in ve, zakaj —
# ne v ozadju. Meja branja je iz istega razloga višja: blok `ld+json` je pogosto na DNU
# dokumenta, za vsem besedilom in komentarji, zato bi 128 kB vrnilo prazno na straneh, ki
# recept pravilno označujejo.
RECIPES_IMPORT_TIMEOUT_MS=5000
RECIPES_IMPORT_MAX_BYTES=1048576
# Dušenje JAVNE poti `/shared-recipes/{token}` po izvornem naslovu. Ni obramba pred ugibanjem
# žetona (128 bitov naključja je prevelik prostor), ampak pred PREGLEDOVANJEM — pred tisočimi
# zahtevami na minuto. Števec živi v pomnilniku procesa in se ob ponovnem zagonu ponastavi;
# to je zavestna razlika do modula 009, kjer se ugiba geslo in mora števec preživeti zagon.
RECIPES_PUBLIC_RATE_LIMIT=60
RECIPES_PUBLIC_RATE_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# 014 — Administratorska analitika (zavihek "Analitika", samo za admina)
# ---------------------------------------------------------------------------
# Vse štiri imajo privzetek v kodi; ta blok je tu zato, da je vidno, KAJ se beleži — ne zato,
# ker bi bilo treba kaj vpisati.
#
# Kaj se NE beleži in se ne bo: IP naslov, uporabniški agent, pot (URL), identifikator seje,
# trajanje in časovni žig posameznega ogleda. V zbirki je ena vrstica na (oseba, zavihek, dan)
# s številom in časom zadnjega ogleda — iz nje poti osebe po aplikaciji ni mogoče sestaviti
# (člen XII).

# Rok hrambe dnevnih števcev. 400 dni = 13 mesecev, ravno toliko, da je mogoče primerjati z
# istim mesecem lani. Uveljavlja ga TTL indeks, ne pometač: rok, ki ga nihče ne izvaja, je
# napaka, ki jo to zaledje drugje že ima (SCREENSHOT_RETENTION_DAYS).
USAGE_RETENTION_DAYS=400
# Okno, v katerem ponoven ogled ISTEGA zavihka ne šteje znova — osvežitev strani ni nov ogled.
# Uveljavljeno na strežniku: števec na odjemalcu ne bi vzdržal dveh oken brskalnika.
USAGE_VIEW_DEDUPE_SECONDS=60
# Veljavnost predpomnjenega pregleda porabe. Seštevanje po vseh zapisih namestitve in sprehod po
# nosilcu sta draga; v petih minutah se ta slika ne spremeni toliko, da bi bilo vredno računati
# znova. Zaslon vedno pokaže, kdaj je bil izračun narejen.
ANALYTICS_CACHE_SECONDS=300
# Starost, pod katero datoteka brez zapisa v bazi NI prijavljena kot sirota: lahko je nalaganje,
# ki ravno teče. Ista vrednost kot v pometaču modula 009 in iz istega razloga.
ANALYTICS_ORPHAN_GRACE_HOURS=24
