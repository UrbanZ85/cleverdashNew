# Kopiraj v .env in izpolni. V gitu je samo ta datoteka, s praznimi vrednostmi (člen IV).
# Popoln opis vsake spremenljivke: docs/env-reference.md

# ─── Osnovno ───
NODE_ENV=production
PORT=3000
TZ=Europe/Ljubljana
PUBLIC_BASE_URL=https://app.si
APP_NAME=CleverDash
LOG_LEVEL=info
# Neobvezno: vrata za Caddy na gostitelju, samo za lokalno preverjanje, kadar je 80/443
# že zaseden. V produkciji pusti prazno (privzeto 80/443).
CADDY_HTTP_PORT=
CADDY_HTTPS_PORT=

# ─── Baza ───
# MONGO_ROOT_USER/MONGO_ROOT_PASSWORD ustvarita uporabnika v vsebniku mongo (infra/docker-compose.yml);
# MONGO_URI je isti uporabnik/geslo v obliki povezovalnega niza, ki ga bere API. Vrednosti
# morata biti usklajeni — to ni preverjeno samodejno.
MONGO_ROOT_USER=cleverdash
MONGO_ROOT_PASSWORD=
MONGO_URI=mongodb://cleverdash:CHANGEME@mongo:27017/cleverdash?authSource=admin

# ─── Avtentikacija ───
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
PASSWORD_HASH_ALGO=argon2id
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ─── Brskalnik (za 002, tukaj že v shemi zaradi skupne konfiguracije) ───
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_PROTOCOL_TIMEOUT_MS=60000
BROWSER_NO_SANDBOX=false

# ─── Scheduler (za 002) ───
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULE_TIMEZONE=Europe/Ljubljana
DRY_RUN=false
CLOCK_PORTAL=puppeteer

# ─── Obvestila ───
# GOOGLE_APPLICATION_CREDENTIALS je pot V VSEBNIKU (stalna). FCM_KEY_FILE je pot na
# GOSTITELJU (per-stroj) — glej infra/docker-compose.yml, ki jo montira kot bind mount.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/fcm_key
FCM_KEY_FILE=
NOTIFY_ON_SUCCESS=false

# ─── Zdravje ───
HEALTHCHECK_PING_URL=
HEALTHCHECK_PING_TIMEOUT_MS=5000

# ─── Datoteke ───
SCREENSHOT_DIR=/app/data/screenshots
SCREENSHOT_RETENTION_DAYS=30

# ─── ARSO ───
ARSO_RADAR_URL=https://meteo.arso.gov.si/uploads/probase/www/observ/radar/si0-rm-anim.gif
ARSO_WEATHER_URL=https://vreme.arso.gov.si/api/1.0/location/
ARSO_DEFAULT_LOCATION=Ljubljana
RADAR_CACHE_SECONDS=300
WEATHER_CACHE_SECONDS=600

# ─── E-pošta (neobvezno — glej research.md §1.2) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
