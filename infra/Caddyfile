# Člen II ustave: enotni izvor. /api/* gre na Node, vse ostalo na SPA build s
# fallbackom na index.html. Brez tega bloka ni druge poddomene za API — ne sme je biti.
#
# PUBLIC_BASE_URL vključuje shemo (npr. "https://app.si") — Caddy jo sprejme kot naslov
# strani in zanjo samodejno pridobi TLS (FR-041). V razvoju nastavi na "http://localhost".
{$PUBLIC_BASE_URL} {
	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	encode gzip
}
